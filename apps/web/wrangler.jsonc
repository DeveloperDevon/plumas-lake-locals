{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plumas-lake-locals-web",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "PUBLIC_APP_URL": "https://staging.plumaslakelocals.com",
    "PUBLIC_APP_DOMAIN": "staging.plumaslakelocals.com"
  },
  // Secrets (DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY) are set per environment via
  // `wrangler secret put <NAME>`, never committed. Durable Objects are still unused - DMs are
  // their own future phase (ADR 0005).
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "plumas-lake-locals-media"
    }
  ]
}
