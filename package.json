{
  "name": "plumas-lake-locals",
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @plumas/db generate",
    "db:migrate": "pnpm --filter @plumas/db migrate",
    "db:seed": "pnpm --filter @plumas/db seed",
    "db:studio": "pnpm --filter @plumas/db studio",
    "changeset": "changeset",
    "release": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "@changesets/cli": "^2.27.0",
    "@plumas/config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3"
  }
}
