# --- Database ---
DATABASE_URL=postgres://plumas:plumas@localhost:5432/plumas_dev

# --- Auth ---
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_DOMAIN=localhost

# --- Email (leave RESEND_API_KEY unset locally to use the console-log transport) ---
RESEND_API_KEY=
EMAIL_FROM="Plumas Lake Locals <hello@plumaslakelocals.com>"

# --- Seed / bootstrap ---
ADMIN_SEED_EMAIL=you@example.com
ADMIN_SEED_INVITE_EMAILS=

# --- Optional / stretch ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observability (optional hook point) ---
SENTRY_DSN=
